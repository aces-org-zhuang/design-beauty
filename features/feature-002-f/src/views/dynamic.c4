  dynamic view seq002F-i-211-lanes {
    variant sequence
    title 'I 环 · Feature-002-F · I-211 泳道流程'
    description '按责任分区。'
    include feat_knowledge_f.lane_ops.actor_operator
    include feat_knowledge_f.us_scan.i_211.ui_211.src_201
    include feat_knowledge_f.us_scan.i_211.i_211_1
    include feat_knowledge_f.us_scan.i_211.i_211_2
