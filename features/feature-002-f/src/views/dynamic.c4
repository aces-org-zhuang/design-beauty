    feat_knowledge_f.us_govern.i_221.ui_221.src_207 -> feat_knowledge_f.pod_document '批准后登记'
  }


  dynamic view dfd002F-src208-1 {
    variant sequence
    title 'SRC 环 · Feature-002-F · SRC-208-DFD-001 知识同步数据流'
    description '归属模块 SRC-208。数据经该模块的流动与转换。'
    include feat_knowledge_f.us_alert.i_231.ui_231.src_208
