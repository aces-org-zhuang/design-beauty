  dynamic view seq002F-i-221-lanes {
    variant sequence
    title 'I 环 · Feature-002-F · I-221 泳道流程'
    description '按责任分区。'
    include feat_knowledge_f.lane_ops.actor_operator
    include feat_knowledge_f.us_govern.i_221.i_221_1
    include feat_knowledge_f.us_govern.i_221.i_221_2
    include feat_knowledge_f.us_govern.i_221.i_221_3
