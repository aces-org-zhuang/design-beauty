    include feat_knowledge_f.us_alert.i_231.i_231_1
    include feat_knowledge_f.us_alert.i_231.i_231_2
    include feat_knowledge_f.lane_ext.ext_ragflow2
    feat_knowledge_f.us_alert.i_231.i_231_1 -> feat_knowledge_f.lane_ext.ext_ragflow2 '①巡检数据集'
    feat_knowledge_f.lane_ext.ext_ragflow2 -> feat_knowledge_f.us_alert.i_231.i_231_2 '②新鲜度判定'
