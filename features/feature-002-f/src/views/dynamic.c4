    feat_knowledge_f.us_alert.i_231.ui_231.src_208 -> feat_knowledge_f.lane_ext.ext_ragflow2 '推送已批准知识'
    feat_knowledge_f.lane_ext.ext_ragflow2 -> feat_knowledge_f.us_alert.i_231.ui_231.src_208 '同步确认'
