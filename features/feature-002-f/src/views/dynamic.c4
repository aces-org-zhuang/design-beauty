    feat_knowledge_f.us_scan.i_211.ui_211.src_201 -> feat_knowledge_f.us_scan.i_211.i_211_1 '②登记素材'
    feat_knowledge_f.us_scan.i_211.i_211_1 -> feat_knowledge_f.us_scan.i_211.i_211_2 '③抽取候选'
    feat_knowledge_f.us_scan.i_211.i_211_2 -> feat_knowledge_f.us_scan.i_211.i_211_3 '④提交候选'
