// 由 scripts/sync-features.mjs 生成，属于 Feature-001-NF · 极端场景 的视图集。
// 模型改动后运行 npm run sync:features 重新生成，不要手工编辑。

views {

  dynamic view dfd001NF-src101-1 {
    variant sequence
    title 'SRC 环 · Feature-001-NF · SRC-101-DFD-001 状态查询数据流'
    description '归属模块 SRC-101。数据经该模块的流动与转换。'
    include feat_degrade_nf.us_kbEmpty.i_111.ui_111.src_101
    include feat_degrade_nf.in_probeQuery
    include feat_degrade_nf.out_status
    feat_degrade_nf.in_probeQuery -> feat_degrade_nf.us_kbEmpty.i_111.ui_111.src_101 '入参进入'
    feat_degrade_nf.us_kbEmpty.i_111.ui_111.src_101 -> feat_degrade_nf.out_status '产出 OUT-101'
  }


  dynamic view dfd001NF-src102-1 {
    variant sequence
    title 'SRC 环 · Feature-001-NF · SRC-102-DFD-001 发布判定数据流'
    description '归属模块 SRC-102。数据经该模块的流动与转换。'
    include feat_degrade_nf.us_ragTimeout.i_122.ui_122.src_102
    include feat_degrade_nf.biz_probeResult
    include feat_degrade_nf.pod_alert
    feat_degrade_nf.biz_probeResult -> feat_degrade_nf.us_ragTimeout.i_122.ui_122.src_102 '探测结论判定'
    feat_degrade_nf.us_ragTimeout.i_122.ui_122.src_102 -> feat_degrade_nf.pod_alert '异常转告警'
  }


  dynamic view dfd001NF-src103-1 {
    variant sequence
