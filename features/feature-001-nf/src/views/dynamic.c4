    include feat_degrade_nf.us_kbEmpty.i_112.ui_112.src_103
    include feat_degrade_nf.biz_probeResult
    include feat_degrade_nf.pod_alert
    feat_degrade_nf.biz_probeResult -> feat_degrade_nf.us_kbEmpty.i_112.ui_112.src_103 '暴露空库'
    feat_degrade_nf.us_kbEmpty.i_112.ui_112.src_103 -> feat_degrade_nf.pod_alert '写入告警'
  }


  dynamic view dfd001NF-src104-1 {
    variant sequence
    title 'SRC 环 · Feature-001-NF · SRC-104-DFD-001 探针数据流'
    description '归属模块 SRC-104。数据经该模块的流动与转换。'
    include feat_degrade_nf.us_kbEmpty.i_111.ui_111.src_104
