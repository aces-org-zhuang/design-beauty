    feat_degrade_nf.us_kbEmpty.i_111.ui_111.src_104 -> feat_degrade_nf.biz_probeResult '产出 BIZ-101'
  }


  dynamic view dfd001NF-src105-1 {
    variant sequence
    title 'SRC 环 · Feature-001-NF · SRC-105-DFD-001 控制台渲染数据流'
    description '归属模块 SRC-105。数据经该模块的流动与转换。'
