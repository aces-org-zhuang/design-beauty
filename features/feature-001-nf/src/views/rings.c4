// 由 scripts/sync-features.mjs 生成，属于 Feature-001-NF · 极端场景 的视图集。
// 模型改动后运行 npm run sync:features 重新生成，不要手工编辑。

views {
  view chain001NF-us {
    title 'US 环 · Feature-001-NF · 用户故事'
    description '本链的用户故事。归属锚是 Feature 容器——US 的直接上层。'
    include feat_degrade_nf
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout
    include feat_degrade_nf.us_llmDown
  }

  view chain001NF-nf {
    title 'NF 环 · Feature-001-NF · 极端场景单元清单'
    description '本链的极端场景单元与对应 US。每项答出谁、什么场景、因此得到什么。'
    include feat_degrade_nf
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout
    include feat_degrade_nf.us_llmDown
