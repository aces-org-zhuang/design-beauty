// Deployment model.
//
// Logical elements deploy onto runtime nodes. Relations from the logical
// model are inherited automatically; only deployment-specific ones are
// declared here.
//
// Note: deployment views do NOT support global style or `include ... with`.
// Use local style rules inside the view.

deployment {
  environment local '本地开发环境' {
    zone appTier '应用层' {
      vm appVm '本机 8787' {
        service = instanceOf beauty {
          title '美妆客服服务'
          technology 'Node.js 20 及以上'
        }
      }
    }

    zone dataTier '数据层' {
      vm storeVm '本地文件系统' {
        store = instanceOf beauty.store {
          title '本地 JSON 存储'
          technology 'data/local-mvp-store.json'
        }
      }

      vm ragflowVm '本机 9380' {
        ragflow = instanceOf ragflow {
          title 'RAGFlow 知识库'
          technology 'HTTP'
        }
      }

      vm wikiVm '本机 19828' {
        wiki = instanceOf llmWiki {
          title 'LLM Wiki 候选源'
          technology 'HTTP'
        }
      }
    }

    appTier.appVm.service -> dataTier.ragflowVm.ragflow 'retrieval over HTTP'
    appTier.appVm.service -> dataTier.wikiVm.wiki 'reads candidate wiki'
    appTier.appVm.service -> dataTier.storeVm.store 'reads and writes'
  }

  environment wechat '企业微信云端' {
    zone wechatTier '企业微信' {
      external wechatApi 'qyapi.weixin.qq.com' {
        title '企业微信开放 API'
        technology 'HTTPS'
      }
    }
  }
}
