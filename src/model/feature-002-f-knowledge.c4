// Feature-002-F · 知识运营能力链
//
// 分叉判据：本次交付新增或改变对外可见的能力 → F 链。
// 编号段：US-2xx / F-2xx / I-2xx / UI-2xx / SRC-2xx / API-2xx。
//
// **I 环按「阶段性目标」纵向切分**：每条 US 拆成若干阶段，
// 每个阶段是一个 I-2xx 元素，内部同时含业务状态与业务步骤。
// **UI 单元对应 I 阶段**（I-2xx → UI-2xx），单元内拆信息/交互叶子。
// **SRC 模块嵌在 UI 单元内，API 嵌在所属模块内。**
//
// 所有 SRC 单元绑定真实路径，取自 BeautyCustomerService 源码树。

model {
  feat_knowledge_f = feature 'Feature-002-F 知识运营能力' {
    description '按业务能力切分。交付边界：运营人员能把素材变成可检索知识，并能发现知识陈旧。所属愿景：让美妆咨询有据可依。'

    // ==================== US-201 ====================

    us_scan = userStory 'US-201 素材入库后自动进入候选知识' {
      description '作为运营人员，我上传美妆素材后，系统能自动扫描出候选知识，以便我不用手工逐条录入。验收：素材入库后能查到扫描出的候选知识条目。'

      // ========== 阶段 I-211：素材入库并产出候选 ==========

      i_211 = implStep 'I-211 阶段性目标 · 素材入库并产出候选' {
        description '把上传的素材变成可审阅的候选条目。做到这一步运营人员就有东西可审了。'

        st_211_pending = state 'S-211 待接入'
        st_211_registering = state 'S-212 登记中'
        st_211_scanning = state 'S-213 扫描中'
        st_211_submitted = state 'S-214 已提交候选'

        st_211_pending -> st_211_registering '上传素材'
        st_211_registering -> st_211_scanning '登记完成'
        st_211_scanning -> st_211_submitted '候选已抽取并提交'

        i_211_1 = implStep 'I-211-1 登记素材' {
          description '把上传的素材登记到文档簿，生成文档标识。'
        }
        i_211_2 = implStep 'I-211-2 抽取候选知识' {
          description '从素材正文中抽取可独立回答问题的候选条目。'
        }
        i_211_3 = implStep 'I-211-3 提交候选' {
          description '把候选条目提交给治理环节，等待决策。'
        }

        // ---- UI-211：对应阶段 I-211 ----

        ui_211 = uiSurface 'UI-211 素材上传' {
          description '对应阶段性目标 I-211。素材上传与扫描进度反馈。'

          ui_211_info_1 = uiSurface 'UI-211-信息设计-001 上传表单信息' {
            description '字段：素材文件、来源标注。覆盖空态（暂无素材）、加载态（扫描中）、错误态（同步失败）、无权限态（未授权）。'
          }
          ui_211_act_1 = uiSurface 'UI-211-交互设计-001 上传提交' {
            description '上传后立即显示扫描进度，支持批量上传。'
          }

          src_201 = srcUnit 'SRC-201 素材路由' {
            description 'src/routes/material-routes.js — 美妆素材接入接口。'

            api_201 = apiEndpoint 'API-201 POST /materials 素材接入' {
              description 'src/routes/material-routes.js:8 — 接收素材。'
            }
          }
          src_203 = srcUnit 'SRC-203 素材服务' {
            description 'src/services/material-service.js — 素材接入规则。'
          }
          src_204 = srcUnit 'SRC-204 素材批处理' {
            description 'src/services/material-batch-service.js — 批量素材接入。'
          }
          src_206 = srcUnit 'SRC-206 知识扫描' {
            description 'src/services/knowledge-scan-service.js — 发现候选知识。'
          }
        }
      }
    }

    // ==================== US-202 ====================

    us_govern = userStory 'US-202 候选知识经我决策后才对外可见' {
      description '作为运营人员，我需要审核候选知识再决定是否发布，以便错误内容不会直接答给客户。验收：候选知识需经我批准才进入知识库。'

      // ========== 阶段 I-221：审阅决策并晋升 ==========

      i_221 = implStep 'I-221 阶段性目标 · 审阅决策并晋升' {
        description '让运营人员逐条审阅候选并决定去留，批准的进入可检索状态。做到这一步 US-202 闭环。'

        st_221_pending = state 'S-221 待审阅'
        st_221_reviewing = state 'S-222 审阅中'
        st_221_decided = state 'S-223 已决策'
        st_221_promoted = state 'S-224 已晋升可检索'
        st_221_rejected = state 'S-225 已驳回退回'

        st_221_pending -> st_221_reviewing '候选提交到治理'
        st_221_reviewing -> st_221_decided '运营人员记录决策'
        st_221_decided -> st_221_promoted '批准晋升'
        st_221_decided -> st_221_rejected '驳回退回'

        i_221_1 = implStep 'I-221-1 人工审阅候选' {
          description '展示候选条目供运营人员逐条审阅。'
        }
        i_221_2 = implStep 'I-221-2 记录决策' {
          description '记录批准或驳回，驳回需填写理由。'
        }
        i_221_3 = implStep 'I-221-3 晋升知识' {
          description '批准的候选进入知识库生命周期，进入可检索状态。'
        }

        // ---- UI-221：对应阶段 I-221 ----

        ui_221 = uiSurface 'UI-221 审阅工作台' {
          description '对应阶段性目标 I-221。候选审阅与决策的操作界面。'

          ui_221_info_1 = uiSurface 'UI-221-信息设计-001 候选条目列表' {
            description '字段：素材标识、来源、扫描状态。覆盖空态（暂无候选）、加载态（载入中）。'
          }
          ui_221_info_2 = uiSurface 'UI-221-信息设计-002 决策记录字段' {
            description '字段：决策结果、驳回理由。驳回时理由必填。'
          }
          ui_221_act_1 = uiSurface 'UI-221-交互设计-001 批准驳回操作' {
            description '逐条批准或驳回，驳回需先填理由再提交；决策不可撤销需二次确认。'
          }

          src_207 = srcUnit 'SRC-207 知识治理' {
            description 'src/services/knowledge-governance-service.js — 发布决策与治理。'
          }
          src_202 = srcUnit 'SRC-202 知识库路由' {
            description 'src/routes/knowledge-routes.js — 知识扫描、同步与生命周期接口。'

            api_202 = apiEndpoint 'API-202 POST /knowledge/scan 知识扫描' {
              description 'src/routes/knowledge-routes.js:10 — 触发候选知识扫描。'
            }
            api_203 = apiEndpoint 'API-203 GET /knowledge/status 知识状态' {
              description 'src/routes/knowledge-routes.js:26 — 查询扫描与治理状态。'
            }
          }
          src_205 = srcUnit 'SRC-205 文档登记簿' {
            description 'src/services/knowledge-document-registry.js — 跟踪素材与文档标识。'
          }
        }
      }
    }

    // ==================== US-203 ====================

    us_alert = userStory 'US-203 知识陈旧时我能收到提示' {
      description '作为运营人员，知识过期或数据集异常时，我能被提醒，以便在客户问到之前修好。验收：知识新鲜度异常时控制台列出问题条目。'

      // ========== 阶段 I-231：巡检并判定新鲜度 ==========

      i_231 = implStep 'I-231 阶段性目标 · 巡检并判定新鲜度' {
        description '定期探测数据集并按更新时间阈值判定是否陈旧。做到这一步就知道哪些条目需要修。'

        st_231_pending = state 'S-231 待巡检'
        st_231_probing = state 'S-232 巡检中'
        st_231_fresh = state 'S-233 新鲜度正常'
        st_231_stale = state 'S-234 新鲜度异常'

        st_231_pending -> st_231_probing '到达巡检周期'
        st_231_probing -> st_231_fresh '全部在阈值内'
        st_231_probing -> st_231_stale '存在超阈值条目'

        i_231_1 = implStep 'I-231-1 巡检数据集状态' {
          description '定期探测知识库数据集的可用性与新鲜度。'
        }
        i_231_2 = implStep 'I-231-2 判定新鲜度异常' {
          description '按更新时间阈值判定是否属于陈旧或异常。'
        }

        // ---- UI-231：对应阶段 I-231 ----

        ui_231 = uiSurface 'UI-231 巡检状态' {
          description '对应阶段性目标 I-231。巡检过程与新鲜度状态呈现。'

          ui_231_info_1 = uiSurface 'UI-231-信息设计-001 新鲜度状态' {
            description '字段：新鲜度天数。覆盖正常态（阈值内）、异常态（超阈值标红）。'
          }
          ui_231_act_1 = uiSurface 'UI-231-交互设计-001 触发巡检' {
            description '巡检自动定期执行，也支持手动触发；结果即时刷新。'
          }

          src_208 = srcUnit 'SRC-208 知识同步' {
            description 'src/services/knowledge-sync-service.js — 把已批准知识推送到 RAGFlow。'
          }
        }
      }

      // ========== 阶段 I-232：上报告警并呈现 ==========

      i_232 = implStep 'I-232 阶段性目标 · 上报告警并呈现' {
        description '把问题条目写入告警并在控制台列出。做到这一步运营人员能在客户问到之前修好。'

        st_232_pending = state 'S-235 待上报'
        st_232_reporting = state 'S-236 上报中'
        st_232_listed = state 'S-237 控制台已列出'
        st_232_fixed = state 'S-238 已修复下线'

        st_232_pending -> st_232_reporting '判定新鲜度异常'
        st_232_reporting -> st_232_listed '告警已落库并展示'
        st_232_listed -> st_232_fixed '运营人员修复后下线'

        i_232_1 = implStep 'I-232-1 上报告警' {
          description '把问题条目写入告警并在控制台列出。'
        }

        // ---- UI-232：对应阶段 I-232 ----

        ui_232 = uiSurface 'UI-232 告警呈现' {
          description '对应阶段性目标 I-232。问题条目的告警列表与处理入口。'

          ui_232_info_1 = uiSurface 'UI-232-信息设计-001 告警列表' {
            description '字段：问题条目标识、新鲜度天数、异常原因。覆盖空态（无异常）、异常态（列出新问题）。'
          }
          ui_232_act_1 = uiSurface 'UI-232-交互设计-001 告警处理' {
            description '从告警条目直达修复入口，处理后标记下线。'
          }

          src_209 = srcUnit 'SRC-209 知识生命周期视图' {
            description 'src/services/knowledge-lifecycle-service.js — 知识的晋升与下线。'
          }
        }
      }
    }

    // ---- F 单元清单：与 US 并列，非路径环节 ----

    f_ingest = function 'F-201 素材接入能力' {
      description '接收素材并登记文档标识，支持单条与批量。'
    }
    f_govern = function 'F-202 知识治理能力' {
      description '候选知识的扫描、决策、晋升与下线。'
    }

    // ---- SRC 环：数据载体（按角色编号） ----

    in_material = dto 'IN-201 素材入参' {
      description 'src/routes/material-routes.js — 上传素材的请求载荷。'
    }
    biz_candidate = entity 'BIZ-201 候选知识对象' {
      description 'src/services/knowledge-scan-service.js — 承载扫描出的候选条目与决策状态。'
    }
    pod_document = entity 'POD-201 文档登记实体' {
      description 'data/local-mvp-store.json — 与 store.json 中 documents 数组结构对应。'
    }
    out_knowledgeStatus = vo 'OUT-201 知识状态出参视图' {
      description 'src/routes/knowledge-routes.js — 面向控制台的扫描与治理状态载荷。'
    }
    dao_registry = dataAccess 'DAO-201 文档登记访问' {
      description 'src/domain/store.js — 素材与文档标识的读写边界。'
    }
    cvt_material = converter 'CVT-201 素材转换器' {
      description 'src/services/material-service.js — 覆盖 素材载荷→BIZ-201 与 BIZ-201→POD-201 两组映射。'
    }

    // ---- 泳道：只是视图分组手段，不是存放位置 ----

    lane_ops = feature '运营人员泳道' {
      actor_operator = person '运营人员'
    }
    lane_core = feature '治理层泳道' {
      description '治理层负责审阅与决策。具体环节见各阶段内的模块与步骤，此处不重复定义。'
    }
    lane_ext = feature '外部依赖泳道' {
      ext_ragflow2 = system 'RAGFlow' {
        description '知识库与检索服务。'
      }
      ext_wiki = system 'LLM Wiki' {
        description '生成的 wiki 候选来源。'
      }
    }

    // ---- 追溯边：清单项的来源 ----

    us_scan .trace f_ingest '要求'
    us_govern .trace f_govern '要求'
    us_alert .trace f_govern '要求'

    // ---- 追溯边：阶段之间的流转 ----

    us_scan.i_211 .trace us_govern.i_221 '提交候选进入治理'
    us_govern.i_221 .trace us_alert.i_231 '晋升后进入新鲜度巡检'
    us_alert.i_231 .trace us_alert.i_232 '判定异常后上报告警'

    // ---- 依赖边：运行时怎么走 ----

    us_scan.i_211.ui_211.src_201 .depends us_scan.i_211.ui_211.src_203 '接收素材'
    us_scan.i_211.ui_211.src_204 .depends us_scan.i_211.ui_211.src_203 '批量接入'
    us_scan.i_211.ui_211.src_203 .depends us_govern.i_221.ui_221.src_205 '登记文档'
    us_govern.i_221.ui_221.src_202 .depends us_scan.i_211.ui_211.src_206 '触发扫描'
    us_scan.i_211.ui_211.src_206 .depends us_govern.i_221.ui_221.src_207 '提交候选'
    us_govern.i_221.ui_221.src_207 .depends us_alert.i_231.ui_231.src_208 '批准后推送'
    us_alert.i_231.ui_231.src_208 .depends us_alert.i_232.ui_232.src_209 '更新生命周期'
    us_alert.i_232.ui_232.src_209 .depends us_govern.i_221.ui_221.src_205 '晋升或下线'

    // ---- 数据流 ----

    lane_ops.actor_operator -> us_scan.i_211.ui_211.src_201.api_201 '上传素材'
    us_scan.i_211.ui_211.src_201.api_201 .flow in_material '构造入参'
    in_material .convert biz_candidate '转换为候选对象'
    biz_candidate .convert pod_document '登记为文档实体'
    pod_document .flow dao_registry '写入文档标识'
    dao_registry .flow out_knowledgeStatus '查询状态'
    out_knowledgeStatus .flow us_govern.i_221.ui_221.ui_221_info_1 '渲染状态'

    // ---- 转换单元覆盖范围 ----

    cvt_material .trace biz_candidate '负责 素材→BIZ-201 映射'
    cvt_material .trace pod_document '负责 BIZ-201→POD-201 映射'
  }
}