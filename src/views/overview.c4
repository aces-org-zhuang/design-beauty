// Element views: landscape, container, and component detail.
// Every view is named because the name becomes the export filename and the
// share URL. View properties must precede predicates.

views {
  view index {
    title '美妆客服服务 · 总览'
    description '顶层系统、参与者与外部平台'
    include *
  }

  view context {
    title '系统上下文'
    description '客户与运营人员接入本服务；企业微信、RAGFlow 与 LLM Wiki 属于外部系统'
    include customer, operator, beauty, wechatWork, ragflow, llmWiki
  }

  view container {
    title '容器与集成'
    description 'HTTP 入口、编排、知识生命周期与外部适配器'
    include beauty.wechatCallback, beauty.fakeWechat, beauty.operatorUi
    include beauty.answerOrchestrator, beauty.answerLoop, beauty.handoffService
    include beauty.knowledgeRoutes, beauty.materialRoutes, beauty.integrationRoutes
    include beauty.ragflowKnowledge, beauty.wechatPlatform, beauty.store
    include wechatWork, ragflow, llmWiki
  }

  view answerPath of beauty {
    title '应答链路'
    description '消息进入后经检索与策略，最终回复或转人工'
    include beauty.fakeWechat, beauty.wechatCallback, beauty.wechatPlatform
    include beauty.answerOrchestrator, beauty.answerLoop, beauty.replyPolicy
    include beauty.evaluationGate, beauty.handoffService, beauty.ragflowKnowledge
    include beauty.store, wechatWork, ragflow
  }

  view knowledgeLifecycle of beauty {
    title '知识生命周期视图'
    description '扫描、治理、同步到 RAGFlow、晋升与新鲜度告警'
    include beauty.knowledgeRoutes, beauty.materialRoutes, beauty.knowledgeScan
    include beauty.governance, beauty.evaluationGate, beauty.knowledgeSync
    include beauty.knowledgeLifecycle, beauty.documentRegistry, beauty.knowledgeAlert
    include beauty.materialService, beauty.materialBatch
    include beauty.ragflowKnowledge, beauty.ragflowLifecycleProbe, beauty.store
    include ragflow, llmWiki
  }

  view operatorSurface {
    title '运营台依赖面'
    description '运营控制台依赖的组件'
    include operator, beauty.operatorUi
    include beauty.handoffRoutes, beauty.knowledgeRoutes, beauty.integrationRoutes
    include beauty.handoffService, beauty.materialRoutes
  }
}
