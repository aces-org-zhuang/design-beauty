// 时序视图与 DFD：dynamic view variant sequence。
//
// 命名规范：seq<链>-<场景>，如 seq001F-answer / seq001F-branch-low-confidence。
//
// 实测约束：
//   - dynamic view 不支持 of <容器>，归属靠 description 表达
//   - 只能有消息，否则 validate 通过但 build 布局失败（actors array must not be empty）
//   - dynamic view 不能与 element view 混在同一 views 块
//   - 视图名可用连字符，如 pano-f、seq001F-answer

views {
  dynamic view seq001F-answer {
    variant sequence
    title 'SRC 环 · Feature-001-F · 应答主干时序'
    description '归属 Feature-001-F。客户提问经回调、编排、检索、校验后得到答复。dynamic view 不支持 of，归属写在此处。'

    include feat_answer_f.lane_client.actor_customer
    include feat_answer_f.lane_edge.api_chatCallback
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_ragflowKnowledge
    include feat_answer_f.lane_ext.ext_ragflow
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_replyPolicy

    feat_answer_f.lane_client.actor_customer -> feat_answer_f.lane_edge.api_chatCallback '企业微信提问'
    feat_answer_f.lane_edge.api_chatCallback -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator '分发归一化消息'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_ragflowKnowledge '检索候选知识'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_ragflowKnowledge -> feat_answer_f.lane_ext.ext_ragflow '请求 RAGFlow'
    feat_answer_f.lane_ext.ext_ragflow -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_ragflowKnowledge '返回候选知识'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_replyPolicy '校验置信度'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_replyPolicy -> feat_answer_f.lane_edge.api_chatCallback '达标放行并返回答复'
  }

  dynamic view seq001F-branch-low-confidence-src {
    variant sequence
    title 'SRC 环 · Feature-001-F · 分支时序 · 置信度不足转人工'
    description '归属 Feature-001-F 的 SRC 环。自策略校验节点岔出，经编排到工单落库。SRC 环的分支，与 I 环的分支各自成图。'

    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_replyPolicy
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_handoffService
    include feat_answer_f.us_ask.i_ask_deliver.ui_information.src_store

    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_replyPolicy -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator '置信度不足'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_answerOrchestrator -> feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_handoffService '转人工'
    feat_answer_f.us_ask.i_ask_deliver.ui_interaction.src_handoffService -> feat_answer_f.us_ask.i_ask_deliver.ui_information.src_store '持久化工单'
  }

  dynamic view dfd001F-answer {
    variant sequence
    title 'SRC 环 · Feature-001-F · 数据流 · 应答'
    description '归属 Feature-001-F。业务数据从提问入参到落库再回显的完整链路，含转换点。'

    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction
    include feat_answer_f.in_chatMessage, feat_answer_f.biz_query
    include feat_answer_f.pod_ticket, feat_answer_f.dao_store
    include feat_answer_f.out_answer, feat_answer_f.us_ask.i_ask_deliver.ui_information

    feat_answer_f.us_ask.i_ask_deliver.ui_interaction -> feat_answer_f.in_chatMessage '提交提问'
    feat_answer_f.in_chatMessage -> feat_answer_f.biz_query '转换为检索查询'
    feat_answer_f.biz_query -> feat_answer_f.pod_ticket '低置信度落工单'
    feat_answer_f.pod_ticket -> feat_answer_f.dao_store '写入工单'
    feat_answer_f.dao_store -> feat_answer_f.out_answer '查询答复内容'
    feat_answer_f.out_answer -> feat_answer_f.us_ask.i_ask_deliver.ui_information '渲染答复'
  }

  dynamic view seq001NF-degrade {
    variant sequence
    title 'SRC 环 · Feature-001-NF · 场景判定时序'
    description '归属 Feature-001-NF。运营查询状态后依次判定三类极端场景并给出提示。'

    include feat_degrade_nf.lane_operator.actor_ops
    include feat_degrade_nf.lane_edge.api_status
    include feat_degrade_nf.us_kbEmpty.i_kb_count
    include feat_degrade_nf.lane_ext.ext_ragflow
    include feat_degrade_nf.us_llmDown.i_ll_notify
    include feat_degrade_nf.lane_operator.actor_ops

    feat_degrade_nf.lane_operator.actor_ops -> feat_degrade_nf.lane_edge.api_status '查询集成状态'
    feat_degrade_nf.lane_edge.api_status -> feat_degrade_nf.us_kbEmpty.i_kb_count '发起探测'
    feat_degrade_nf.us_kbEmpty.i_kb_count -> feat_degrade_nf.lane_ext.ext_ragflow '探测数据集可用性'
    feat_degrade_nf.lane_ext.ext_ragflow -> feat_degrade_nf.us_kbEmpty.i_kb_count '返回探测结论'
    feat_degrade_nf.us_kbEmpty.i_kb_count -> feat_degrade_nf.us_llmDown.i_ll_notify '提交发布判定并下发提示'
    feat_degrade_nf.us_llmDown.i_ll_notify -> feat_degrade_nf.lane_operator.actor_ops '告知客户'
  }

  dynamic view dfd001NF-probe {
    variant sequence
    title 'SRC 环 · Feature-001-NF · 数据流 · 探测'
    description '归属 Feature-001-NF。探测入参到状态出参与告警落库的完整链路。'

    include feat_degrade_nf.lane_operator.actor_ops
    include feat_degrade_nf.in_probeQuery, feat_degrade_nf.biz_probeResult
    include feat_degrade_nf.out_status, feat_degrade_nf.us_kbEmpty.i_kb_render.ui_status
    include feat_degrade_nf.pod_alert, feat_degrade_nf.dao_alert

    feat_degrade_nf.lane_operator.actor_ops -> feat_degrade_nf.in_probeQuery '构造探测入参'
    feat_degrade_nf.in_probeQuery -> feat_degrade_nf.biz_probeResult '转换为探测结果'
    feat_degrade_nf.biz_probeResult -> feat_degrade_nf.out_status '渲染状态载荷'
    feat_degrade_nf.out_status -> feat_degrade_nf.us_kbEmpty.i_kb_render.ui_status '显示条目数与异常提示'
    feat_degrade_nf.biz_probeResult -> feat_degrade_nf.pod_alert '异常转告警实体'
    feat_degrade_nf.pod_alert -> feat_degrade_nf.dao_alert '写入告警'
  }

  dynamic view seq001F-i-step-lanes {
    variant sequence
    title 'I 环 · Feature-001-F · 业务步骤泳道流程'
    description '归属 Feature-001-F。用嵌套后的真实 I 环步骤表达主干：归一化 → 检索 → 排序 → 校验 → 生成 → 下发。泳道按责任分区，步骤本身嵌在 US 容器内。'

    include feat_answer_f.lane_client.actor_customer
    include feat_answer_f.lane_edge.api_chatCallback
    include feat_answer_f.us_ask.i_ask_normalize
    include feat_answer_f.us_ask.i_ask_retrieve
    include feat_answer_f.us_ask.i_ask_rank
    include feat_answer_f.us_ask.i_ask_verify
    include feat_answer_f.us_ask.i_ask_compose
    include feat_answer_f.us_ask.i_ask_deliver
    include feat_answer_f.lane_ext.ext_ragflow

    feat_answer_f.lane_client.actor_customer -> feat_answer_f.lane_edge.api_chatCallback '①提出问题'
    feat_answer_f.lane_edge.api_chatCallback -> feat_answer_f.us_ask.i_ask_normalize '②归一化提问'
    feat_answer_f.us_ask.i_ask_normalize -> feat_answer_f.us_ask.i_ask_retrieve '③发起检索'
    feat_answer_f.us_ask.i_ask_retrieve -> feat_answer_f.lane_ext.ext_ragflow '④请求RAGFlow'
    feat_answer_f.lane_ext.ext_ragflow -> feat_answer_f.us_ask.i_ask_retrieve '⑤返回候选知识'
    feat_answer_f.us_ask.i_ask_retrieve -> feat_answer_f.us_ask.i_ask_rank '⑥候选排序'
    feat_answer_f.us_ask.i_ask_rank -> feat_answer_f.us_ask.i_ask_verify '⑦置信度校验'
    feat_answer_f.us_ask.i_ask_verify -> feat_answer_f.us_ask.i_ask_compose '⑧生成答复'
    feat_answer_f.us_ask.i_ask_compose -> feat_answer_f.us_ask.i_ask_deliver '⑨下发答复'
    feat_answer_f.us_ask.i_ask_deliver -> feat_answer_f.lane_edge.api_chatCallback '⑩回复会话'
    feat_answer_f.lane_edge.api_chatCallback -> feat_answer_f.lane_client.actor_customer '⑪答复送达'
  }

  dynamic view seq001F-branch-low-confidence {
    variant sequence
    title 'I 环 · Feature-001-F · 分支泳道流程 · 置信度不足'
    description '归属 Feature-001-F。自置信度校验节点岔出，走 US-002 的三个步骤。分支独立成图，不重复主干步骤。'

    include feat_answer_f.us_ask.i_ask_verify
    include feat_answer_f.us_lowConfidence.i_lowEscalate
    include feat_answer_f.us_lowConfidence.i_lowTicket
    include feat_answer_f.us_lowConfidence.i_lowNotify
    include feat_answer_f.lane_edge.api_chatCallback

    feat_answer_f.us_ask.i_ask_verify -> feat_answer_f.us_lowConfidence.i_lowEscalate '置信度不足'
    feat_answer_f.us_lowConfidence.i_lowEscalate -> feat_answer_f.us_lowConfidence.i_lowTicket '创建工单'
    feat_answer_f.us_lowConfidence.i_lowTicket -> feat_answer_f.us_lowConfidence.i_lowNotify '告知等待'
    feat_answer_f.us_lowConfidence.i_lowNotify -> feat_answer_f.lane_edge.api_chatCallback '回复会话'
  }

  dynamic view seq001NF-i-step-lanes {
    variant sequence
    title 'I 环 · Feature-001-NF · 场景判定泳道流程'
    description '归属 Feature-001-NF。运营发起查询、判定层依次判定三类极端场景、提示层给出下一步。'

    include feat_degrade_nf.lane_operator.actor_ops
    include feat_degrade_nf.lane_edge.api_status
    include feat_degrade_nf.us_kbEmpty.i_kb_count
    include feat_degrade_nf.us_kbEmpty.i_kb_judge
    include feat_degrade_nf.us_ragTimeout.i_to_check
    include feat_degrade_nf.us_llmDown.i_ll_detect

    feat_degrade_nf.lane_operator.actor_ops -> feat_degrade_nf.lane_edge.api_status '①查询状态'
    feat_degrade_nf.lane_edge.api_status -> feat_degrade_nf.us_kbEmpty.i_kb_count '②发起探测'
    feat_degrade_nf.us_kbEmpty.i_kb_count -> feat_degrade_nf.us_kbEmpty.i_kb_judge '③判定条目数'
    feat_degrade_nf.us_kbEmpty.i_kb_judge -> feat_degrade_nf.us_ragTimeout.i_to_check '④判定响应耗时'
    feat_degrade_nf.us_ragTimeout.i_to_check -> feat_degrade_nf.us_llmDown.i_ll_detect '⑤判定模型可用性'
    feat_degrade_nf.us_llmDown.i_ll_detect -> feat_degrade_nf.lane_operator.actor_ops '⑥下发提示或转人工'
  }

  dynamic view seq001F-api-chat {
    variant sequence
    title 'SRC 环 · Feature-001-F · 接口泳道时序 · 提交提问'
    description '泳道按调用方向：客户 → 服务端接入 → 领域层 → 外部依赖。'

    include feat_answer_f.lane_client.actor_customer
    include feat_answer_f.lane_edge.api_chatCallback
    include feat_answer_f.us_ask.i_ask_deliver
    include feat_answer_f.lane_ext.ext_ragflow

    feat_answer_f.lane_client.actor_customer -> feat_answer_f.lane_edge.api_chatCallback 'POST /wechat/callback'
    feat_answer_f.lane_edge.api_chatCallback -> feat_answer_f.us_ask.i_ask_deliver '触发应答'
    feat_answer_f.us_ask.i_ask_deliver -> feat_answer_f.lane_ext.ext_ragflow '检索知识'
    feat_answer_f.lane_ext.ext_ragflow -> feat_answer_f.us_ask.i_ask_deliver '返回候选知识'
    feat_answer_f.us_ask.i_ask_deliver -> feat_answer_f.lane_edge.api_chatCallback '返回答复'
  }

  dynamic view seq001NF-api-status {
    variant sequence
    title 'SRC 环 · Feature-001-NF · 接口泳道时序 · 查询集成状态'
    description '泳道按调用方向：运营人员 → 服务端接入 → 判定层 → 外部依赖。'

    include feat_degrade_nf.lane_operator.actor_ops
    include feat_degrade_nf.lane_edge.api_status
    include feat_degrade_nf.us_kbEmpty.i_kb_count
    include feat_degrade_nf.lane_ext.ext_ragflow

    feat_degrade_nf.lane_operator.actor_ops -> feat_degrade_nf.lane_edge.api_status 'GET /integration/status'
    feat_degrade_nf.lane_edge.api_status -> feat_degrade_nf.us_kbEmpty.i_kb_count '发起探测'
    feat_degrade_nf.us_kbEmpty.i_kb_count -> feat_degrade_nf.lane_ext.ext_ragflow '探测数据集'
    feat_degrade_nf.lane_ext.ext_ragflow -> feat_degrade_nf.us_kbEmpty.i_kb_count '返回结论'
  }
}
