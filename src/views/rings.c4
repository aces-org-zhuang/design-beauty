// 分环视图：每条链的每一环各自一张图，聚焦该环自己的表达。
//
// 核心原则：一张图只回答一个问题，且只承载同一类的内容。
//   US 环  → 这个角色要达成什么（意图与验收）
//   能力清单 → 这条链交付了哪些单元，与谁对应
//   I 环   → 业务目标 / 状态流转 / 业务步骤，三者分开成图
//   UI 环  → 交互面与信息设计
//   SRC 环 → 代码结构（见 srcdir 视图）
//
// **禁止 `include *` 这类写法**：它会把六个环全部塞进一张图，
// 让「F 层视图里出现 US」这类问题无法避免。
//
// 命名规范：
//   chain<链>-<环>          分环视图，如 chain001F-us
//   chain<链>-i-<子类>      I 环按内容子类拆分，如 chain001F-i-state
//   pano-<环>               同类聚合的全景，如 pano-f

views {
  view chain001F-us of feat_answer_f {
    title 'US 视图 · Feature-001-F'
    description '只承载本链的用户故事：这个角色在什么场景下要达成什么、怎样算完成。不含能力单元、I 环与源码。'
    include feat_answer_f.us_ask, feat_answer_f.us_lowConfidence
  }

  view chain001NF-us of feat_degrade_nf {
    title 'US 视图 · Feature-001-NF'
    description '只承载极端场景链的用户故事。每条都绑定一个具体场景，不是质量角度。'
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout, feat_degrade_nf.us_llmDown
  }

  view chain001F-f of feat_answer_f {
    title '能力清单 · Feature-001-F'
    description '本链交付的业务能力单元，以及每个单元由哪条 US 要求。清单与 US 并列，不是下钻路径的一步——这里同时出现 US 是为了展示对应关系，不是把 US 当成能力单元。'
    include feat_answer_f.us_ask, feat_answer_f.us_lowConfidence
    include feat_answer_f.f_answer, feat_answer_f.f_retrieval
  }

  view chain001NF-nf of feat_degrade_nf {
    title '场景清单 · Feature-001-NF'
    description '本链交付的极端场景单元，以及每项由哪条 US 要求。每一项都答出谁、什么场景、因此得到什么。US 在此仅用于展示对应关系。'
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout, feat_degrade_nf.us_llmDown
    include feat_degrade_nf.nf_kbEmpty
    include feat_degrade_nf.nf_ragTimeout, feat_degrade_nf.nf_llmDown
  }

  view chain001F-i-goal of feat_answer_f {
    title 'I 环 · 业务目标 · Feature-001-F'
    description '只承载业务目标。状态流转与业务步骤各自成图，不混在这张里。'
    include feat_answer_f.i_goal
  }

  view chain001F-i-step of feat_answer_f {
    title 'I 环 · 业务步骤 · Feature-001-F'
    description '归属靠嵌套容器表达：US 作为容器标识，这些步骤属于哪条 US 一眼可见。不画 US→I 的连线，也不把 US 与 I 平铺在一起。'
    include feat_answer_f.us_ask
    include feat_answer_f.us_lowConfidence
  }

  view chain001NF-i-goal of feat_degrade_nf {
    title 'I 环 · 业务目标 · Feature-001-NF'
    description '极端场景链的业务目标。'
    include feat_degrade_nf.i_goal
  }

  view chain001NF-i-step of feat_degrade_nf {
    title 'I 环 · 场景判定步骤 · Feature-001-NF'
    description '三类极端场景的判定步骤静态结构。'
    include feat_degrade_nf.us_kbEmpty
  }

  view chain001F-ui of feat_answer_f {
    title 'UI 环 · Feature-001-F'
    description '只承载交互面与信息设计。不含源码与数据载体。'
    include feat_answer_f.ui_interaction, feat_answer_f.ui_information
  }

  view chain001NF-ui of feat_degrade_nf {
    title 'UI 环 · Feature-001-NF'
    description '极端场景链的交互面与信息设计。'
    include feat_degrade_nf.ui_status, feat_degrade_nf.ui_notice
  }

  view chain002F-us of feat_knowledge_f {
    title 'US 视图 · Feature-002-F'
    description '只承载本链的用户故事。不含能力单元、I 环与源码。'
    include feat_knowledge_f.us_scan, feat_knowledge_f.us_govern
    include feat_knowledge_f.us_alert
  }

  view chain002F-f of feat_knowledge_f {
    title '能力清单 · Feature-002-F'
    description '本链的业务能力单元与对应 US。US 在此仅用于展示对应关系。'
    include feat_knowledge_f.us_scan, feat_knowledge_f.us_govern
    include feat_knowledge_f.us_alert
    include feat_knowledge_f.f_ingest, feat_knowledge_f.f_govern
  }

  view chain002F-i-goal of feat_knowledge_f {
    title 'I 环 · 业务目标 · Feature-002-F'
    description '只承载业务目标。状态流转与业务步骤各自成图。'
    include feat_knowledge_f.i_goal
  }

  view chain002F-i-step of feat_knowledge_f {
    title 'I 环 · 业务步骤 · Feature-002-F'
    description '只承载主干治理步骤的静态结构。'
    include feat_knowledge_f.us_scan
  }

  view chain002F-ui of feat_knowledge_f {
    title 'UI 环 · Feature-002-F'
    description '只承载交互面与信息设计。'
    include feat_knowledge_f.ui_console, feat_knowledge_f.ui_information
  }

  view srcdir002F of feat_knowledge_f {
    title 'SRC 目录视图 · Feature-002-F'
    description '本链源码单元与真实文件路径的对应。'
    include feat_knowledge_f.src_materialRoutes, feat_knowledge_f.src_knowledgeRoutes
    include feat_knowledge_f.src_materialService, feat_knowledge_f.src_materialBatch
    include feat_knowledge_f.src_documentRegistry, feat_knowledge_f.src_knowledgeScan
    include feat_knowledge_f.src_governance, feat_knowledge_f.src_knowledgeSync
    include feat_knowledge_f.src_lifecycle
  }

  view carrier002F of feat_knowledge_f {
    title '数据载体全景 · Feature-002-F'
    description '本链的数据载体与转换关系。'
    include feat_knowledge_f.in_material, feat_knowledge_f.biz_candidate
    include feat_knowledge_f.pod_document, feat_knowledge_f.out_knowledgeStatus
    include feat_knowledge_f.dao_registry, feat_knowledge_f.cvt_material
  }

  view erm002F of feat_knowledge_f {
    title '数据模型全景 · Feature-002-F 文档结构'
    description '本链的持久化实体与数据访问单元。'
    include feat_knowledge_f.pod_document, feat_knowledge_f.dao_registry
  }

  view api002F of feat_knowledge_f.lane_edge {
    title 'API 清单 · Feature-002-F'
    description '本链对外接口，含方法、路径与路由位置。'
    include feat_knowledge_f.lane_edge
  }
}
