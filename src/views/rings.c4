// 分环视图：每条链的每一环各自一张图，聚焦该环自己的表达。
//
// 两条硬规则同时生效：
//   1. 一张图只承载一个环
//   2. 最多跨一层——出现的层只能是「本环 + 直接上一层」
//
// 层级链：Feature → US → I → UI → SRC
//   US 视图的锚是 Feature
//   I  视图的锚是 US
//   UI 视图的锚是 I
//   SRC 视图的锚是 UI
//
// **注意**：LikeC4 的 `include` **不会自动带出子元素**。
// 只 include US 容器渲染出来是一个空 US 框，里面的 I 步骤一个都不显示。
// 必须祖先与目标元素同时显式 include，才能渲染成 US[I-001, I-002]。
//
// **禁止 `include *`**：它会把六个环加上数据载体、泳道全塞进一张。
//
// 命名规范：
//   chain<链>-<环>          分环视图，如 chain001F-us
//   chain<链>-i-<子类>      I 环按内容子类拆分，如 chain001F-i-state
//   pano-<环>               同类聚合的全景，如 pano-f

views {
  view chain001F-us {
    title 'US 环 · Feature-001-F · 用户故事'
    description '只承载本链的用户故事：这个角色在什么场景下要达成什么、怎样算完成。归属锚是 Feature 容器——US 的直接上层。不含能力单元、I 环与源码。'
    include feat_answer_f
    include feat_answer_f.us_ask, feat_answer_f.us_lowConfidence
  }

  view chain001NF-us {
    title 'US 环 · Feature-001-NF · 用户故事'
    description '只承载极端场景链的用户故事。每条都绑定一个具体场景，不是质量角度。归属锚是 Feature 容器。'
    include feat_degrade_nf
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout, feat_degrade_nf.us_llmDown
  }

  view chain001F-f {
    title 'F 环 · Feature-001-F · 业务能力单元清单'
    description '本链交付的业务能力单元，以及每个单元由哪条 US 要求。清单与 US 并列，不是下钻路径的一步——这里同时出现 US 是为了展示对应关系，不是把 US 当成能力单元。'
    include feat_answer_f
    include feat_answer_f.us_ask, feat_answer_f.us_lowConfidence
    include feat_answer_f.f_answer, feat_answer_f.f_retrieval
  }

  view chain001NF-nf {
    title 'NF 环 · Feature-001-NF · 极端场景单元清单'
    description '本链交付的极端场景单元，以及每项由哪条 US 要求。每一项都答出谁、什么场景、因此得到什么。US 在此仅用于展示对应关系。'
    include feat_degrade_nf
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_ragTimeout, feat_degrade_nf.us_llmDown
    include feat_degrade_nf.nf_kbEmpty
    include feat_degrade_nf.nf_ragTimeout, feat_degrade_nf.nf_llmDown
  }

  view chain001F-i-goal {
    title 'I 环 · Feature-001-F · 业务目标'
    description '只承载业务目标。归属锚是 Feature 容器下的业务目标元素本身，它不属于任何单条 US。状态流转与业务步骤各自成图。'
    include feat_answer_f.i_goal
  }

  view chain001F-i-step {
    title 'I 环 · Feature-001-F · 业务步骤'
    description '归属靠 US 容器表达：US 作为容器标识，这些步骤属于哪条 US 一眼可见。祖先与目标元素同时 include，否则步骤不会显示。不画 US→I 的连线。'
    include feat_answer_f.us_ask
    include feat_answer_f.us_ask.i_ask_normalize, feat_answer_f.us_ask.i_ask_retrieve
    include feat_answer_f.us_ask.i_ask_rank, feat_answer_f.us_ask.i_ask_verify
    include feat_answer_f.us_ask.i_ask_compose, feat_answer_f.us_ask.i_ask_deliver
    include feat_answer_f.us_lowConfidence
    include feat_answer_f.us_lowConfidence.i_lowEscalate, feat_answer_f.us_lowConfidence.i_lowTicket
    include feat_answer_f.us_lowConfidence.i_lowNotify
  }

  view chain001NF-i-goal {
    title 'I 环 · Feature-001-NF · 业务目标'
    description '极端场景链的业务目标。归属锚是 Feature 容器下的业务目标元素本身。'
    include feat_degrade_nf.i_goal
  }

  view chain001NF-i-step {
    title 'I 环 · Feature-001-NF · 场景判定步骤'
    description '三类极端场景的判定步骤。归属靠 US 容器表达，祖先与目标元素同时 include。'
    include feat_degrade_nf.us_kbEmpty
    include feat_degrade_nf.us_kbEmpty.i_kb_count, feat_degrade_nf.us_kbEmpty.i_kb_judge
    include feat_degrade_nf.us_kbEmpty.i_kb_render
    include feat_degrade_nf.us_ragTimeout
    include feat_degrade_nf.us_ragTimeout.i_to_timer, feat_degrade_nf.us_ragTimeout.i_to_check
    include feat_degrade_nf.us_ragTimeout.i_to_notify
    include feat_degrade_nf.us_llmDown
    include feat_degrade_nf.us_llmDown.i_ll_detect, feat_degrade_nf.us_llmDown.i_ll_ticket
    include feat_degrade_nf.us_llmDown.i_ll_notify
  }

  view chain001F-ui {
    title 'UI 环 · Feature-001-F · 交互面与信息设计'
    description '只承载交互面与信息设计。归属锚是 I 步骤容器——UI 的直接上层是 I，不是 Feature 更不是 US。不含源码与数据载体。'
    include feat_answer_f.us_ask.i_ask_deliver
    include feat_answer_f.us_ask.i_ask_deliver.ui_interaction
    include feat_answer_f.us_ask.i_ask_deliver.ui_information
  }

  view chain001NF-ui {
    title 'UI 环 · Feature-001-NF · 交互面 · 空库提示'
    description '极端场景链的交互面。归属锚是 I 步骤容器。本链 UI 分属不同 US，按 US 拆分以避免越层。'
    include feat_degrade_nf.us_kbEmpty.i_kb_render
    include feat_degrade_nf.us_kbEmpty.i_kb_render.ui_status
  }

  view chain001NF-ui-notice {
    title 'UI 环 · Feature-001-NF · 交互面 · 场景提示'
    description '归属锚是 I 步骤容器。按 US 拆分以避免越层。'
    include feat_degrade_nf.us_llmDown.i_ll_notify
    include feat_degrade_nf.us_llmDown.i_ll_notify.ui_notice
  }

  view chain002F-us {
    title 'US 环 · Feature-002-F · 用户故事'
    description '只承载本链的用户故事。归属锚是 Feature 容器。不含能力单元、I 环与源码。'
    include feat_knowledge_f
    include feat_knowledge_f.us_scan, feat_knowledge_f.us_govern
    include feat_knowledge_f.us_alert
  }

  view chain002F-f {
    title 'F 环 · Feature-002-F · 业务能力单元清单'
    description '本链的业务能力单元与对应 US。US 在此仅用于展示对应关系。'
    include feat_knowledge_f
    include feat_knowledge_f.us_scan, feat_knowledge_f.us_govern
    include feat_knowledge_f.us_alert
    include feat_knowledge_f.f_ingest, feat_knowledge_f.f_govern
  }

  view chain002F-i-goal {
    title 'I 环 · Feature-002-F · 业务目标'
    description '只承载业务目标。归属锚是业务目标元素本身。状态流转与业务步骤各自成图。'
    include feat_knowledge_f.i_goal
  }

  view chain002F-i-step {
    title 'I 环 · Feature-002-F · 业务步骤'
    description '主干治理步骤。归属靠 US 容器表达，祖先与目标元素同时 include。'
    include feat_knowledge_f.us_scan
    include feat_knowledge_f.us_scan.i_scan_register, feat_knowledge_f.us_scan.i_scan_extract
    include feat_knowledge_f.us_scan.i_scan_submit
    include feat_knowledge_f.us_govern
    include feat_knowledge_f.us_govern.i_gov_review, feat_knowledge_f.us_govern.i_gov_decide
    include feat_knowledge_f.us_govern.i_gov_promote
    include feat_knowledge_f.us_alert
    include feat_knowledge_f.us_alert.i_alert_probe, feat_knowledge_f.us_alert.i_alert_judge
    include feat_knowledge_f.us_alert.i_alert_report
  }

  view chain002F-ui {
    title 'UI 环 · Feature-002-F · 交互面与信息设计'
    description '只承载交互面与信息设计。归属锚是 I 步骤容器。'
    include feat_knowledge_f.us_alert.i_alert_report
    include feat_knowledge_f.us_alert.i_alert_report.ui_console, feat_knowledge_f.us_alert.i_alert_report.ui_information
  }

  view srcdir002F {
    title 'SRC 环 · Feature-002-F · 代码结构'
    description '本链源码单元与真实文件路径的对应。归属锚是 UI 面容器——SRC 的直接上层是 UI，不是 Feature，也绝不出现 F 单元。'
    include feat_knowledge_f.us_alert.i_alert_report.ui_console
    include feat_knowledge_f.us_alert.i_alert_report.ui_console.src_materialRoutes
    include feat_knowledge_f.us_alert.i_alert_report.ui_console.src_materialService
    include feat_knowledge_f.us_alert.i_alert_report.ui_console.src_materialBatch
    include feat_knowledge_f.us_alert.i_alert_report.ui_console.src_knowledgeScan
    include feat_knowledge_f.us_alert.i_alert_report.ui_console.src_governance
    include feat_knowledge_f.us_alert.i_alert_report.ui_information
    include feat_knowledge_f.us_alert.i_alert_report.ui_information.src_knowledgeRoutes
    include feat_knowledge_f.us_alert.i_alert_report.ui_information.src_documentRegistry
    include feat_knowledge_f.us_alert.i_alert_report.ui_information.src_knowledgeSync
    include feat_knowledge_f.us_alert.i_alert_report.ui_information.src_lifecycle
  }

  view carrier002F {
    title 'SRC 环 · Feature-002-F · 数据载体'
    description '本链的数据载体与转换关系。数据载体是 SRC 环内部的横向维度，不属于 UI→SRC 这条纵向路径，因此平铺不强制带容器。'
    include feat_knowledge_f.in_material, feat_knowledge_f.biz_candidate
    include feat_knowledge_f.pod_document, feat_knowledge_f.out_knowledgeStatus
    include feat_knowledge_f.dao_registry, feat_knowledge_f.cvt_material
  }

  view erm002F-document {
    title 'SRC 环 · Feature-002-F · 数据模型 · 文档'
    description '本链的持久化实体与数据访问单元。SRC 内部横向维度，平铺。'
    include feat_knowledge_f.pod_document, feat_knowledge_f.dao_registry
  }

  view api002F of feat_knowledge_f.lane_edge {
    title 'SRC 环 · Feature-002-F · 对外接口'
    description '本链对外接口，含方法、路径与路由位置。归属锚是接入泳道容器。'
    include feat_knowledge_f.lane_edge
  }
}
